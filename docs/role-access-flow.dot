digraph G { graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.5"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, margin="0.2,0.12", color="#334155"]; edge [color="#64748B", penwidth=1.4, arrowsize=0.75, fontname="Arial", fontsize=10]; user [label="User", fillcolor="#E9E2FF", color="#7357D6"]; login [label="Login / Register\n(future extension)", fillcolor="#DBF2FF", color="#2693C7"]; auth [label="Validate credentials\nand issue JWT", fillcolor="#FFF0C7", color="#D79A00"]; route [label="Role Router", fillcolor="#DDF7E8", color="#3D9B66"]; customer [label="User Workspace\nHARVIX Chat", fillcolor="#F2EEFF", color="#8B78E6"]; admin [label="Admin Workspace\nfuture extension", fillcolor="#FFF1DD", color="#C58A44"]; user -> login -> auth -> route; route -> customer [label="user"] ; route -> admin [label="admin"]; }