digraph G { graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.5"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, margin="0.2,0.12", color="#334155"]; edge [color="#64748B", penwidth=1.4, arrowsize=0.75, fontname="Arial", fontsize=10]; upload [label="Upload document\nfuture RAG extension", fillcolor="#E9E2FF", color="#7357D6"]; validate [label="Validate type\nand size", fillcolor="#DBF2FF", color="#2693C7"]; extract [label="Extract text\nPDF / DOCX / TXT / MD", fillcolor="#FFF0C7", color="#D79A00"]; chunk [label="Split into\ncontext chunks", fillcolor="#DDF7E8", color="#3D9B66"]; embed [label="Generate\nembeddings", fillcolor="#E8ECF1", color="#64748B"]; index [label="Store vector index\nfuture knowledge base", fillcolor="#FFE5E5", color="#C65B5B"]; upload -> validate -> extract -> chunk -> embed -> index; }